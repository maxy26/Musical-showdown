{
  "name": "musical-showdown",
  "version": "1.0.0",
  "description": "Musical Showdown - juego de canciones para familia/amigos (web, escritorio y Android)",
  "private": true,
  "scripts": {
    "build:desktop": "node build/build-desktop.js",
    "build:linux": "node build/build-desktop.js --linux",
    "build:store-windows": "node build/build-desktop.js --store",
    "build:android": "node build/build-android.js",
    "build:apk": "node build/build-android.js --apk",
    "android:release": "node build/android-release.js",
    "build:all": "npm run build:desktop && npm run build:android",
    "test": "node --test test/*.test.js",
    "lint": "eslint src",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.5"
  }
}
