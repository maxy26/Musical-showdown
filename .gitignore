# Dependencias (se reinstalan con npm install)
node_modules/

# Salidas de build (se regeneran con npm run build:*)
dist/
platforms/desktop/www/
platforms/android/www/
platforms/android/android/app/build/
platforms/android/android/.gradle/
platforms/android/android/app/src/main/assets/public/
platforms/android/android/capacitor-cordova-android-plugins/build/

# Clave de firma de Android (secreta; hacer copia de seguridad fuera del repo)
platforms/android/keystore/

# Firebase (notificaciones): configuración y clave de la cuenta de servicio.
# En GitHub Actions salen de los secretos GOOGLE_SERVICES_JSON y FIREBASE_SERVICE_ACCOUNT.
platforms/android/android/app/google-services.json
*firebase-adminsdk*.json

# Android Studio / Gradle locales
platforms/android/android/local.properties
platforms/android/android/.idea/
platforms/android/android/**/build/

# Sistema
.DS_Store
Thumbs.db

# Resultados de las pruebas de pantallas (Playwright)
test-results/
playwright-report/
